# Everything here is optional. The app runs with no environment variables at all.
# Leave these lines commented out unless you really need them: an empty value is ignored,
# but there is no reason to set one.

# Canonical URL, used for Open Graph, sitemap and robots.
# Falls back to Vercel's production URL, then http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Base URL that serves model_fp16.onnx and model_quantized.onnx.
# Leave unset to use the Hugging Face repo. See "Self-hosting the model" in the README.
# NEXT_PUBLIC_MODEL_BASE_URL=https://your-host.example/models
